{
  "common": {
    "name": "marstek-venus",
    "version": "0.1.2",
    "news": {
      "0.1.2": {
        "en": "Fix admin UI",
        "de": "Admin UI Fix"
      },
      "0.1.0": {
        "en": "Initial release",
        "de": "Erstveröffentlichung"
      }
    },
    "title": "Marstek Venus",
    "titleLang": {
      "en": "Marstek Venus Battery",
      "de": "Marstek Venus Speicher"
    },
    "desc": {
      "en": "Integrates Marstek Venus A/D battery storage systems into ioBroker via the local Open API (UDP).",
      "de": "Integriert Marstek Venus A/D Batteriespeicher in ioBroker über die lokale Open API (UDP)."
    },
    "authors": ["Your Name <your@email.com>"],
    "keywords": ["marstek", "venus", "battery", "energy storage", "solar"],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "main": "main.js",
    "icon": "admin/marstek-venus.png",
    "enabled": true,
    "loglevel": "info",
    "mode": "daemon",
    "type": "energy",
    "singleton": false,
    "allowInit": false,
    "dependencies": [{ "js-controller": ">=5.0.0" }],
    "globalDependencies": [],
    "messagebox": false,
    "subscribable": false,
    "compact": true,
    "connectionType": "local",
    "dataSource": "poll",
    "tier": 2,
    "adminUI": {
      "config": "json"
    }
  },
  "native": {
    "host": "",
    "port": 30000,
    "pollInterval": 30,
    "passiveDuration": 60
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": { "name": "Device Information" },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "Connected",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}
