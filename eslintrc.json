<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marstek Venus Adapter</title>
    <link rel="stylesheet" type="text/css" href="../../lib/css/adapter.css" />
    <script type="text/javascript" src="../../lib/js/jquery-bundle.js"></script>
    <script type="text/javascript" src="../../socket.io/socket.io.js"></script>
    <script type="text/javascript" src="../../lib/js/translate.js"></script>
    <script type="text/javascript" src="../../lib/js/adapter-settings.js"></script>
    <style>
        body { font-family: Arial, sans-serif; padding: 16px; }
        .field-row { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; }
        .field-row .input-field { flex: 1; min-width: 200px; }
        .input-field label { display: block; font-weight: bold; margin-bottom: 4px; font-size: 0.9em; color: #333; }
        .input-field input { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9em; box-sizing: border-box; }
        .input-field .help { font-size: 0.8em; color: #888; margin-top: 4px; }
        .section-title { font-size: 1.1em; font-weight: bold; margin: 20px 0 10px; color: #1a73e8; border-bottom: 2px solid #1a73e8; padding-bottom: 4px; }
        .info-box { background: #e8f4fd; border-left: 4px solid #1a73e8; padding: 12px 16px; border-radius: 4px; margin: 16px 0; font-size: 0.85em; line-height: 1.6; }
        .button-row { display: flex; gap: 12px; margin-top: 28px; padding-top: 16px; border-top: 1px solid #e0e0e0; }
        .btn-save { background: #1a73e8; color: #fff; border: none; padding: 10px 28px; border-radius: 4px; font-size: 0.95em; cursor: pointer; font-weight: bold; }
        .btn-save:hover { background: #1557b0; }
        .btn-cancel { background: #fff; color: #555; border: 1px solid #bbb; padding: 10px 28px; border-radius: 4px; font-size: 0.95em; cursor: pointer; }
        .btn-cancel:hover { background: #f5f5f5; }
    </style>
</head>
<body>
<div class="m adapter-container">

    <div class="section-title">Verbindung</div>
    <div class="field-row">
        <div class="input-field">
            <label for="host">IP-Adresse des Marstek Venus</label>
            <input type="text" id="host" class="value" placeholder="z.B. 192.168.188.50" />
            <div class="help">Leer lassen für automatische Erkennung per UDP-Broadcast im Netzwerk</div>
        </div>
        <div class="input-field">
            <label for="port">UDP-Port</label>
            <input type="number" id="port" class="value" value="30000" min="1" max="65535" />
            <div class="help">Standard: 30000 – wie in der Marstek App unter Local API eingestellt</div>
        </div>
    </div>

    <div class="section-title">Abfrage</div>
    <div class="field-row">
        <div class="input-field">
            <label for="pollInterval">Abfrageintervall (Sekunden)</label>
            <input type="number" id="pollInterval" class="value" value="30" min="5" max="3600" />
            <div class="help">Wie oft werden die Werte vom Gerät gelesen? Minimum: 5 Sekunden</div>
        </div>
        <div class="input-field">
            <label for="passiveDuration">Passive Modus Dauer (Minuten)</label>
            <input type="number" id="passiveDuration" class="value" value="60" min="1" max="1440" />
            <div class="help">Standard-Dauer wenn Passivmodus über control.setPassivePower aktiviert wird</div>
        </div>
    </div>

    <div class="info-box">
        <strong>Voraussetzung:</strong> Bitte aktiviere die <em>Local API</em> in der Marstek App unter
        <em>Einstellungen → Local API</em> (App-Version ≥ 1.6.51). Notiere den dort angezeigten UDP-Port.
        Das Gerät muss im selben Netzwerk wie ioBroker erreichbar sein.
    </div>

    <div class="button-row">
        <button class="btn-save" id="save">Speichern</button>
        <button class="btn-cancel" id="cancel">Abbrechen</button>
    </div>

</div>

<script type="text/javascript">
    function load(settings, onChange) {
        if (!settings) return;
        $('.value').each(function () {
            var $this = $(this);
            var id = $this.attr('id');
            if (settings[id] !== undefined && settings[id] !== null) {
                $this.val(settings[id]);
            }
            $this.on('change keyup', function () { onChange(); });
        });
    }

    function save(callback) {
        var obj = {};
        $('.value').each(function () {
            var $this = $(this);
            var id = $this.attr('id');
            var type = $this.attr('type');
            if (type === 'number') {
                obj[id] = parseFloat($this.val()) || 0;
            } else {
                obj[id] = $this.val();
            }
        });
        callback(obj);
    }

    $(document).ready(function () {
        $('#save').on('click', function () {
            save(function (obj) {
                socket.emit('setObject', 'system.adapter.marstek-venus.0', { native: obj }, function (err) {
                    if (!err) {
                        socket.emit('extendObject', 'system.adapter.marstek-venus.0', { native: obj }, function () {
                            window.history.back();
                        });
                    }
                });
            });
        });
        $('#cancel').on('click', function () {
            window.history.back();
        });
    });
</script>
</body>
</html>
